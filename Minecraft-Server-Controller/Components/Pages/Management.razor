@page "/manage"
@rendermode InteractiveServer
@inject ServerManager Manager


<button class="send-button" @onclick="Start">
	Start
</button>

<button class="send-button" @onclick="Stop">
	Stop
</button>

<button class="send-button" @onclick="Restart">
	Restart
</button>

<button class="send-button" @onclick="Save">
	Save
</button>

<button class="send-button" @onclick="ForceSave">
	Force Save
</button>

<button class="send-button" @onclick="Backup">
	Backup
</button>

@code {

	RCONCommandRunner Runner = new RCONCommandRunner("server", 25575);

	private async Task Save()
	{
		await Manager.Save();
	}

	private async Task ForceSave()
	{
		await Manager.ForceSave();
	}

	private async Task Start()
	{
		await Manager.Start();
	}

	private async Task Stop()
	{
		await Manager.Stop();
	}

	private async Task Restart()
	{
		await Manager.Restart();
	}

	private async Task Backup()
	{
		
	}
}
