@page "/"
@rendermode InteractiveServer
@inject ServerStatus Status

<PageTitle>Home</PageTitle>

<h1>Server Controller</h1>

<h2>Server Online : @Status.Online</h2>
<h2>Players Online : @Status.OnlinePlayers</h2>

@code{

	protected override void OnInitialized()
	{
		Status.OnUpdated += Ping;
	}

	private void Ping()
	{
		InvokeAsync(StateHasChanged);
	}
}