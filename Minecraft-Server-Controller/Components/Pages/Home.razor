@page "/"
@rendermode InteractiveServer
@inject HeartbeatService Service

<PageTitle>Home</PageTitle>

<h1>Server Controller</h1>

<h2>Server Online : @Service.LatestPingResult.Online</h2>
<h2>Players Online : @Service.LatestPingResult.OnlinePlayers</h2>

@code{

	protected override void OnInitialized()
	{
		Service.OnPingResult += Ping;
	}

	private void Ping()
	{
		InvokeAsync(StateHasChanged);
	}
}