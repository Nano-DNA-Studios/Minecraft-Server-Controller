@page "/message"
@rendermode InteractiveServer

<div class="message-card">

	<div class="message-header">
		<h3>Broadcast Message</h3>
		<p>Send a message to every player currently online.</p>
	</div>

	<div class="message-body">

		<textarea class="message-input"
				  @bind="MessageStr"
				  placeholder="Enter your message...">
        </textarea>

		<select class="message-select" @bind="SelectedColor">
			<option value="">White (Default)</option>

			@foreach (string color in Colors)
			{
				<option value="@color.ToLower()">@color</option>
			}
		</select>

		<button class="send-button" @onclick="SendMessage">
			Send Message
		</button>

	</div>
</div>

<style>

	.message-card {
		max-width: 700px;
		margin: 40px auto;
		background: #111827;
		border: 1px solid #2b3648;
		border-radius: 14px;
		overflow: hidden;
		box-shadow: 0 8px 24px rgba(0,0,0,.35);
	}

	.message-header {
		padding: 20px 24px;
		background: #1a2233;
		border-bottom: 1px solid #2b3648;
	}

		.message-header h3 {
			margin: 0;
			color: white;
			font-size: 1.4rem;
		}

		.message-header p {
			margin: 6px 0 0;
			color: #9ca3af;
		}

	.message-body {
		display: flex;
		flex-direction: column;
		gap: 18px;
		padding: 24px;
	}

	.message-input {
		resize: vertical;
		min-height: 120px;
		padding: 14px;
		font-size: 1rem;
		background: #0f172a;
		color: white;
		border: 1px solid #374151;
		border-radius: 10px;
		transition: .2s;
	}

		.message-input:focus {
			outline: none;
			border-color: #3b82f6;
			box-shadow: 0 0 0 3px rgba(59,130,246,.25);
		}

	.message-select {
		padding: 12px;
		font-size: 1rem;
		background: #0f172a;
		color: white;
		border: 1px solid #374151;
		border-radius: 10px;
		transition: .2s;
	}

		.message-select:focus {
			outline: none;
			border-color: #3b82f6;
			box-shadow: 0 0 0 3px rgba(59,130,246,.25);
		}

	.send-button {
		align-self: flex-end;
		padding: 12px 28px;
		background: #2563eb;
		color: white;
		border: none;
		border-radius: 10px;
		font-size: 1rem;
		font-weight: 600;
		cursor: pointer;
		transition: .2s;
	}

		.send-button:hover {
			background: #1d4ed8;
			transform: translateY(-1px);
		}

		.send-button:active {
			transform: translateY(0);
		}

</style>

@code {

	RCONCommandRunner Runner = new RCONCommandRunner("server", 25575);

	string MessageStr = string.Empty;

	string SelectedColor = string.Empty;

	string[] Colors = ["Red", "Gold", "Blue", "Green"];

	private void SendMessage()
	{
		Runner.Run($"tellraw @a {{\"text\":\"{MessageStr}\",\"color\":\"{SelectedColor}\"}}");
	}
}
