@page "/rcon"
@rendermode InteractiveServer
@inject ServerManager Manager

<div class="message-card">

	<div class="message-header">
		<h3>Run Command</h3>
		<p>Run a Server Command using RCON</p>
	</div>

	<div class="message-body">

		<input class="message-input"
			   @bind="CommandStr"
			   placeholder="Enter your Command...">
		</input>

		<button class="send-button" @onclick="SendCommand">
			Run Command
		</button>

	</div>

</div>

<div class="message-card log-card">
	<div class="message-header">
		<h3>Command Logs</h3>
		<p>Recent RCON output</p>
	</div>

	<div class="log-body">
		@if (CommandLogs.Count == 0)
		{
			<div class="log-empty">No logs yet.</div>
		}
		else
		{
			@foreach (var log in CommandLogs)
			{
				<div class="log-line">@log</div>
			}
		}
	</div>
</div>

@code {
	RCONCommandRunner Runner = new RCONCommandRunner("server", 25575);

	string CommandStr = string.Empty;

	List<string> CommandLogs = new List<string>();

	private async Task SendCommand()
	{
		if (string.IsNullOrWhiteSpace(CommandStr))
			return;

		await Manager.RunCommand(CommandStr);
	}
}
